# ASHA OneCapture Environment Configuration

# Flask Core
FLASK_ENV=development
SECRET_KEY=asha-onecapture-secret-key-kalachakra2026
DATABASE_URL=sqlite:///asha_onecapture.db

# SMS Provider Configuration
# Choose: 'mock' (default for local development and demos) or 'twilio' (for production SMS)
SMS_PROVIDER=mock

# Twilio SMS Credentials (Required only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STATUS_CALLBACK_URL=

# Operational Safeguards
SMS_COOLDOWN_HOURS=24
SMS_MAX_RETRIES=3
